# Production Backend/.env — copy values into Backend/.env on the server.
# Never commit Backend/.env (secrets).

APP_NAME=Anya Music School API
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=false
API_PREFIX=/api/v1

# Public shop + admin (same-origin API via nginx on each host)
CORS_ORIGINS=https://anyamusicschool.com,https://admin.anyamusicschool.com
FILE_BASE_URL=https://anyamusicschool.com

# --- Database (match docker-compose db service) ---
DATABASE_URL=postgresql+psycopg2://ecom-admin:CHANGE_ME@db:5432/ecommerce
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom-admin
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT (generate: openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
LOCAL_PERSISTENT_LOGIN=false

# --- Redis / Celery (docker service names) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true
BACKEND_REPLICAS=1
