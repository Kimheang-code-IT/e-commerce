# Copy to `.env` in project root, or run: python scripts/deploy_lan.py
# Regenerate on each computer (DHCP IP changes).

HOST_LAN_IP=192.168.1.20
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443
CORS_ALLOW_LAN=true

# Empty = works on any LAN IP (relative API /api/v1). Optional OG/meta only:
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_USE_BACKEND_API=true
FILE_BASE_URL=

# API replicas behind nginx (least_conn). Keep telegram-bot at 1 instance.
# API containers behind nginx (1 = single backend)
BACKEND_REPLICAS=1
