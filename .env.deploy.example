# Copy to `.env` in project root, or run: python scripts/deploy_lan.py
# Regenerate on each computer (DHCP IP changes).
# If you renamed the project folder, set COMPOSE_PROJECT_NAME to the OLD folder name
# so Docker reuses existing volumes (e-comerce_pg_data, etc.) — data is NOT in the folder.

# Must match the project that created ecom-postgres / e-comerce_pg_data (do not use e-commerce).
COMPOSE_PROJECT_NAME=e-comerce
HOST_LAN_IP=192.168.1.20
PUBLIC_HTTP_PORT=8081
PUBLIC_HTTPS_PORT=8443
CORS_ALLOW_LAN=true

# Empty = works on any LAN IP (relative API /api/v1). Optional OG/meta only:
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_USE_BACKEND_API=true
FILE_BASE_URL=

# API replicas behind nginx (least_conn). Keep telegram-bot at 1 instance.
# API containers behind nginx (1 = single backend, 2+ = load balanced)
BACKEND_REPLICAS=1

# --- Production VPS (copy to Backend/.env) ---
# APP_ENV=production
# APP_DEBUG=false
# API_DOCS_ENABLED=false
# CORS_ALLOW_LAN=false
# CORS_ORIGINS=https://your-domain.example
# SCHEDULER_ENABLED=false
# CACHE_ENABLED=true
# BACKEND_REPLICAS=2
# Deploy: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --scale backend=2
# Verify: .\scripts\verify_lb.ps1
