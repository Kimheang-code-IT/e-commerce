# Copy to `.env` in project root, or run: python scripts/deploy_lan.py
# Regenerate on each computer (DHCP IP changes).
# If you renamed the project folder, set COMPOSE_PROJECT_NAME to the OLD folder name
# so Docker reuses existing volumes (e-comerce_pg_data, etc.) — data is NOT in the folder.

# Must match the project that created ecom-postgres / e-comerce_pg_data (do not use e-commerce).
COMPOSE_PROJECT_NAME=e-comerce
HOST_LAN_IP=192.168.1.20
CORS_ALLOW_LAN=true

# Build frontend before host nginx serves the SPA:
#   cd Frontend && pnpm install && pnpm exec nuxi generate
# NUXT_PUBLIC_* are baked at generate time:
NUXT_PUBLIC_SITE_URL=https://domank-dontrey.in
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_USE_BACKEND_API=true
FILE_BASE_URL=

# Optional: docker compose up -d --scale backend=2 (Docker LB on 127.0.0.1:8000)
BACKEND_REPLICAS=1

# --- Production (copy to Backend/.env) ---
# APP_ENV=production
# APP_DEBUG=false
# API_DOCS_ENABLED=false
# CORS_ALLOW_LAN=false
# CORS_ORIGINS=https://domank-dontrey.in,http://192.168.1.20
# SCHEDULER_ENABLED=false
# CACHE_ENABLED=true
# Host nginx: see host-nginx-examples/domank-dontrey.in.conf.sample
# Docker: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
