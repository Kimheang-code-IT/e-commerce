# Copy to Frontend/.env for local `pnpm dev` — safe to commit
# Production: https://admin.anyamusicschool.com (nginx IP allowlist — see deploy/HOSTING.md)

NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_USE_BACKEND_API=true

# Production build (deploy/scripts/build-admin.sh sets these automatically):
# NUXT_PUBLIC_SITE_URL=https://admin.anyamusicschool.com
