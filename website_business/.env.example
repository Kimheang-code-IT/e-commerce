# Public site URL (required for SEO: canonical, sitemap, Open Graph)
# Production: https://anyamusicschool.com
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend catalog API (categories + products for product grid)
# Production behind nginx: https://anyamusicschool.com/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
