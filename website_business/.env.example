# Public site URL (required for SEO: canonical, sitemap, Open Graph)
# Production: https://anyamusicschool.com
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend catalog API (categories + products for product grid)
# Production behind nginx: https://anyamusicschool.com/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Google Search Console — HTML tag method (Property settings → Verification → HTML tag)
# Copy only the content value, e.g. abc123xyz (not the full meta tag)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<meta name="google-site-verification" content="5BNRjT7h8ONl_lUjaoiXOK6LM8gIpF0dHmd-8ltN63A" />

# Optional: Bing Webmaster Tools
NUXT_PUBLIC_BING_SITE_VERIFICATION=<meta name="msvalidate.01" content="3E6BA499AB5B23085685831BC87434D3" />
