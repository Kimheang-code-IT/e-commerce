# Copy to Backend/.env — safe to commit. Never commit Backend/.env or credentials/*.json
# Docker: encode special chars in DATABASE_URL password (! → %21, @ → %40, $ → %24)

# --- App ---
APP_NAME=E-Commerce API
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=false
API_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API.
# Production example values below (copy into Backend/.env on server)
# Local dev: admin 3000, public shop 3001
# Production: CORS_ORIGINS=https://anyamusicschool.com,https://admin.anyamusicschool.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Public URL for product image links: https://anyamusicschool.com
FILE_BASE_URL=
EXPORT_INLINE_THRESHOLD=100
EXPORT_DIR=exports

# --- Database (API + db container) ---
DATABASE_URL=postgresql+psycopg2://ecom-admin:CHANGE_ME@db:5432/ecommerce
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom-admin
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=e-comerce-backend
JWT_AUDIENCE=
# Dev convenience only; ignored when APP_ENV=production
LOCAL_PERSISTENT_LOGIN=true
LOCAL_ACCESS_TOKEN_EXPIRE_MINUTES=5256000
LOCAL_REFRESH_TOKEN_EXPIRE_DAYS=3650

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=30

# --- Invoices ---
INVOICE_PDF_DIR=uploads/invoices
INVOICE_PDF_SYNC=true
INVOICE_PRINT_ENABLED=false
INVOICE_PRINT_WEBHOOK_URL=

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_CHECKOUT_PER_MINUTE=60

# --- Scheduler (set false in production when celery-beat runs jobs) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Phnom_Penh
# Match root .env BACKEND_REPLICAS when scaling API containers
BACKEND_REPLICAS=1

# --- Google Sheets backup ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/your-service-account.json
GOOGLE_BACKUP_ENABLED=false
GOOGLE_BACKUP_TIME=23:59

# --- Telegram (one telegram-bot container per bot token) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_REPORT_ENABLED=false
TELEGRAM_DAILY_SALES_SUMMARY_ENABLED=true
TELEGRAM_BACKUP_ALERT_ENABLED=true
TELEGRAM_WEBHOOK_SECRET=
# Daily sales summary Telegram (Cambodia time; requires NOTIFY + bot + chat id + celery-beat)
DAILY_SALES_SUMMARY_TIME=19:05
DAILY_SALES_WINDOW_START=07:00
DAILY_SALES_WINDOW_END=19:00

# --- Alerts ---
LOW_STOCK_ALERT_ENABLED=false
LOW_STOCK_THRESHOLD=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# First admin: use /setup when the database has no users (no env seed).
