APP_NAME=E-Commerce API
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://domank-dontrey.in
# true = allow any private LAN IP (Wi-Fi). Production HTTPS: set false and list origins above.
CORS_ALLOW_LAN=true
FILE_BASE_URL=
EXPORT_INLINE_THRESHOLD=100
EXPORT_DIR=exports

# Docker: host `db`, encode special chars in password (! → %21, @ → %40, $ → %24)
DATABASE_URL=postgresql+psycopg2://ecom-admin:CHANGE_ME@db:5432/ecommerce
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom-admin
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=e-comerce-backend
JWT_AUDIENCE=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=30
INVOICE_PDF_DIR=uploads/invoices
INVOICE_PDF_SYNC=true
INVOICE_PRINT_ENABLED=false
INVOICE_PRINT_WEBHOOK_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_CHECKOUT_PER_MINUTE=60

# LAN / single replica: true is OK. Production with celery-beat: set false (cron runs in beat only).
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Phnom_Penh
# Match root .env BACKEND_REPLICAS when scaling API containers (strict scheduler locks when > 1).
BACKEND_REPLICAS=1

# Frontend (host nginx serves static files — rebuild after changing NUXT_PUBLIC_*):
#   cd Frontend && pnpm install && pnpm exec nuxi generate
# Host nginx sample: host-nginx-examples/domank-dontrey.in.conf.sample

# Create sheet in Google Drive; share with service account email from your JSON (client_email) as Editor
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/your-service-account.json
GOOGLE_BACKUP_ENABLED=true
GOOGLE_BACKUP_TIME=19:00

# Bot from @BotFather — same token/chat on every machine; only ONE telegram-bot container may poll
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=true
TELEGRAM_REPORT_ENABLED=true
TELEGRAM_BACKUP_ALERT_ENABLED=true

LOW_STOCK_ALERT_ENABLED=true
LOW_STOCK_THRESHOLD=10

LOG_LEVEL=INFO
LOG_JSON=false

# First admin: use the app /setup page when the database has no users (no env seed).
