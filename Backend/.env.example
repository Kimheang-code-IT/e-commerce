APP_NAME=E-Commerce API
APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true = allow any private LAN IP/port (Wi-Fi deploy)
CORS_ALLOW_LAN=true
FILE_BASE_URL=
EXPORT_INLINE_THRESHOLD=100
EXPORT_DIR=exports

# Docker: host `db`, encode special chars in password (! → %21, @ → %40, $ → %24)
DATABASE_URL=postgresql+psycopg2://ecom-admin:CHANGE_ME@db:5432/ecommerce
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom-admin
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=e-comerce-backend
JWT_AUDIENCE=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=30
INVOICE_PDF_DIR=uploads/invoices
INVOICE_PDF_SYNC=true
INVOICE_PRINT_ENABLED=false
INVOICE_PRINT_WEBHOOK_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_CHECKOUT_PER_MINUTE=60

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Phnom_Penh

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_BACKUP_ENABLED=false
GOOGLE_BACKUP_TIME=19:00

# Your bot from @BotFather — keep the same token/chat on every machine (do not commit Backend/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=true
TELEGRAM_REPORT_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=false

DEFAULT_ADMIN_SEED_ENABLED=true
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
DEFAULT_ADMIN_LEGACY_EMAILS=
